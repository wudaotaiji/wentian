PORT=8787
WENTIAN_HOST=127.0.0.1
# MCPサーバー（Server）は明示的に有効化します。クライアント（Client）の管理画面は /mcp-connections です。
WENTIAN_ENABLE_MCP=false
# 保存先を省略した場合はインストール先の .wentian 配下です。秘密値は環境変数参照で登録します。
# WENTIAN_MCP_CLIENT_CONFIG=C:\Users\your-user\.wentian\mcp-servers.json
# WENTIAN_MCP_CLIENT_AUDIT=C:\Users\your-user\.wentian\mcp-audit.jsonl
# HTTP公開時は公開ホストと必要なブラウザーOriginだけを列挙します。
# WENTIAN_MCP_ALLOWED_HOSTS=localhost,127.0.0.1,[::1],gateway.example.com
# WENTIAN_MCP_ALLOWED_ORIGINS=https://gateway.example.com
# stdioブリッジ（Bridge）で別ホストへ接続する場合のURLと既存APIキーです。
# WENTIAN_MCP_BASE_URL=http://127.0.0.1:8787
# WENTIAN_MCP_API_KEY=your-gateway-api-key
# LAN/WANへ公開する場合は必ず設定してください
# WENTIAN_API_KEY=replace-with-a-long-random-secret
WENTIAN_CORS_ORIGINS=http://127.0.0.1,http://localhost
WENTIAN_REQUEST_TIMEOUT_MS=120000
WENTIAN_HEALTH_TIMEOUT_MS=2000
# 複数プロバイダー定義（既定値も providers.json）
WENTIAN_PROVIDERS_FILE=providers.json
# 利用者が所有するメールアカウントと任意の業務連携です。秘密値はローカルで設定します。
# WENTIAN_MAIL_IMAP_HOST=mail.example.com
# WENTIAN_MAIL_IMAP_USER=member@example.com
# WENTIAN_MAIL_SES_USERNAME=your-account
# WENTIAN_MAIL_SES_PASSWORD=replace-with-your-password
# WENTIAN_BUSINESS_RECORDS_SCRIPT=/path/to/business-records/scripts/start.py
# Plugin Profile、外部Module、Overlayを定義する組立Manifestです。
# 相対パスは導入先基準です。未指定時は作業ディレクトリー、導入先の順に探索します。
# WENTIAN_PLUGIN_MANIFEST=wentian.plugins.json
# Package名からのPlugin読込みは任意コード実行になるため、既定では禁止します。
WENTIAN_ALLOW_PACKAGE_PLUGINS=false
WENTIAN_EVENT_STORE=.wentian/events.jsonl
WENTIAN_EVENT_MAX_RECORDS=10000
WENTIAN_EVENT_MAX_BYTES=16777216
WENTIAN_EVENT_MAX_AGE_MS=2592000000
# 生存確認キャッシュ（Health Check Cache）は既定でユーザーホームの .agent_orchestration に保存します。
# Windows: $env:USERPROFILE\.agent_orchestration / Linux・macOS: ~/.agent_orchestration
# 別の保存先を使う場合だけ指定してください。未作成の summary.json は空の記録で初期化します。
# WENTIAN_AGENT_ORCHESTRATION_DIR=/absolute/path/to/.agent_orchestration
# 状態変更は既定無効。利用時もWENTIAN_API_KEYと明示承認が必要です
WENTIAN_ENABLE_STATE_CHANGES=false
WENTIAN_ENABLE_COMFYUI_JOBS=false
# 外部エージェントのローカル導入は既定無効。APIキーと1回限り承認も必要です
WENTIAN_ENABLE_AGENT_INSTALL=false
# 登録済み・未停止の既知エージェントは、公式パッケージの自動導入から検証まで保守します。
WENTIAN_AGENT_AUTO_INSTALL=true
# Planner AIを先頭で実行します。外部Agent Runnerはユーザーの明示委譲時だけ有効化できます
WENTIAN_PLANNER_MODEL=wentian-auto/all
# 分類API不通時だけ、正常確認済みKilo/OpenCodeで分類を代替します。
WENTIAN_PLANNER_EXTERNAL_FALLBACK=true
# 分類学習環境は scripts/setup-planner-training.ps1 または .py で準備します。
# WENTIAN_TRAINING_PYTHON=C:/path/to/planner-engine/Scripts/python.exe
WENTIAN_ENABLE_EXTERNAL_ORCHESTRATION=true
WENTIAN_AGENT_READY_REFRESH_MS=300000
# 外部AgentのAIネイティブ自動修復は同一Agent内で最大2回です。AI提案は固定Safety Policyで検証します。
WENTIAN_REPAIR_PLANNER_MODEL=wentian-auto/all
WENTIAN_REPAIR_PLANNER_URL=http://127.0.0.1:8787
WENTIAN_REPAIR_PLANNER_TIMEOUT_MS=10000
# 認証・未導入・破壊操作・許可一覧外モデルは自動変更しません。
WENTIAN_OPENCODE_MODEL=opencode/nemotron-3-ultra-free
WENTIAN_OPENCODE_FALLBACK_MODELS=opencode/nemotron-3.5-lightning-free,wentian/wentian-auto/remote,opencode/deepseek-v4-flash-free
WENTIAN_KILO_MODEL=kilo/kilo-auto/free
# 接続設定の内部自動保守（Connection Maintenance）。無料モデルを優先し、必要時はローカルLLMを使用します。
WENTIAN_AGENT_CONNECTION_MAINTENANCE=true
# WENTIAN_OPENCLAW_AGENT=main
# Workflow integration専用MCP Tool。Cookieは秘密値のためGitへ保存しません。
# WENTIAN_INTEGRATION_BASE_URL=https://integration.example.com
# WENTIAN_INTEGRATION_SESSION=短期限のintegration_session値
# 正式構成ではCookieではなく、Kubernetes SecretからサービスTokenを注入します。
# WENTIAN_INTEGRATION_SERVICE_TOKEN=十分長いランダム値
WENTIAN_INTEGRATION_SERVICE_ID=wentian-gateway
WENTIAN_INTEGRATION_TIMEOUT_MS=90000
# 自己LLM学習用データは既定無効です。/training onで明示的に有効化します
WENTIAN_TRAINING_MAX_RECORDS=10000
WENTIAN_TRAINING_MAX_BYTES=67108864
# Mail Solutions の分類・項目抽出モデル学習。Python 環境には scripts/mail-training-requirements.txt を導入します。
# WENTIAN_MAIL_TRAINING_PYTHON=C:\workspace\wentian-gateway\.wentian\mail-engine\Scripts\python.exe
# WENTIAN_MAIL_TRAINING_ROOT=D:\wentian-data\mail-training
# 認証済みConfluence検索。セッションファイル自体はGitへ登録しません
# WENTIAN_CONFLUENCE_BASE_URL=https://confluence.example.com
# WENTIAN_CONFLUENCE_PLAYWRIGHT_ROOT=C:\path\to\browser-profile
# WENTIAN_CONFLUENCE_AUTH_STATE=C:\path\to\auth_state.json
LLAMACPP_BASE_URL=http://127.0.0.1:8080/v1
LLAMACPP_API_KEY=no-key
OLLAMA_BASE_URL=http://127.0.0.1:11434/v1
OLLAMA_API_KEY=ollama
LMSTUDIO_BASE_URL=http://127.0.0.1:1234/v1
LMSTUDIO_API_KEY=lm-studio
WENTIAN_LOCAL_LLM_BASE_URL=http://127.0.0.1:1234/v1
WENTIAN_LOCAL_LLM_MODEL=local-model
COMFYUI_BASE_URL=http://127.0.0.1:8188
# Optional remote provider (disabled unless set)
# WENTIAN_REMOTE_BASE_URL=https://...
# WENTIAN_REMOTE_API_KEY=...

# ComfyUIに依存しない動画生成。autoはCUDA GPUがなければCPUを使用します。
WENTIAN_VIDEO_DEVICE=auto
# 既定はインストール先の .wentian/video-engine にある専用環境・モデルです。
# WENTIAN_VIDEO_PYTHON=C:\workspace\wentian-gateway\.wentian\video-engine\Scripts\python.exe
# WENTIAN_VIDEO_MODEL_PATH=D:\wentian-video-model
# 動画・ジョブ台帳を別ドライブに保存する場合に指定します。
# WENTIAN_VIDEO_ROOT=D:\wentian-videos

# 音声・動画制作とモデル自動保守（Model Maintenance）。
WENTIAN_AUDIO_DEVICE=auto
# WENTIAN_AUDIO_MODEL_ROOT=D:\wentian-audio-models
# WENTIAN_MEDIA_ROOT=D:\wentian-media
# WENTIAN_MEDIA_MAINTENANCE_ROOT=D:\wentian-model-maintenance
WENTIAN_MEDIA_MODEL_MAINTENANCE=true
# 未設定時はWentian専用のFFmpegを優先します。
# WENTIAN_FFMPEG=C:\tools\ffmpeg.exe
# WENTIAN_FFPROBE=C:\tools\ffprobe.exe

# メーカー商取引（Maker Commerce）。認証情報未設定では決済作成を拒否します。
# WENTIAN_COMMERCE_STORE=D:\wentian-data\commerce.sqlite
WENTIAN_COMMERCE_ORIGIN=http://127.0.0.1:8787
# Stripeのテスト用秘密鍵・Webhook署名鍵は環境変数で設定し、Gitへ保存しません。
# WENTIAN_STRIPE_SECRET_KEY=sk_test_...
# WENTIAN_STRIPE_WEBHOOK_SECRET=whsec_...
WENTIAN_COMMERCE_ALLOW_LIVE=false
# AI企画支援を使う場合だけ、接続済みモデル名を明示します。
# WENTIAN_COMMERCE_PLANNER_MODEL=provider/model
# 独自ドメイン（Custom Domain）は所有確認後だけCaddyの専用ルートへ登録します。
# Caddy管理APIはループバック限定。既存サイトの設定全体は置換しません。
# WENTIAN_COMMERCE_CADDY_ADMIN=http://127.0.0.1:2019
# WENTIAN_COMMERCE_CADDY_ROUTES=/config/apps/http/servers/wentian/routes
# WENTIAN_COMMERCE_UPSTREAM=127.0.0.1:8787
# 契約価格（Contract Prices）の配信元JSON。未設定時は外部価格を取得しません。
# WENTIAN_COMMERCE_PRICE_SOURCES_FILE=C:/secure/commerce-price-sources.json

# プロジェクト知識庫のベクトル検索。接続先・モデルは利用者が明示してください。
# OpenAI互換APIの /embeddings より前のURLを指定します。特定の接続先・モデルは既定にしません。
# 両方設定すると検索のautoがハイブリッド検索になります。未設定時のautoは字句検索です。
# WENTIAN_KNOWLEDGE_EMBEDDING_BASE_URL=https://your-embedding-service.example/v1
# WENTIAN_KNOWLEDGE_EMBEDDING_MODEL=your-embedding-model
# 必要なサービスでのみ秘密キーを設定します。ローカルの.envに保存し、公開しないでください。
# WENTIAN_KNOWLEDGE_EMBEDDING_API_KEY=

# 認証・社内接続を使う収集。接続元・許可プロジェクトをJSONで指定します。
# examples/knowledge/sources.example.jsonを秘密の設定領域へコピーして編集してください。
# WENTIAN_KNOWLEDGE_SOURCES_FILE=C:/private/wentian/sources.json
# 必要な環境だけブラウザー実行ファイル・収集用プロキシを明示してください。
# 未指定時は npx playwright install chromium で導入するChromiumを使います。
# WENTIAN_KNOWLEDGE_BROWSER_EXECUTABLE=C:/your-browser/browser.exe
# PDFの文字抽出・スキャン描画も同じ一時ブラウザーを使います。
# NodeのネイティブCanvasは不要です。ブラウザー未導入時はChromiumを準備するか実行ファイルを明示してください。
# WENTIAN_KNOWLEDGE_PROXY=http://your-proxy.example:8080
# 画像・PDFのスキャンや図表を読むVisionモデル。ローカル互換APIも指定できます。
# WENTIAN_KNOWLEDGE_VISION_BASE_URL=https://your-vision-service.example/v1
# WENTIAN_KNOWLEDGE_VISION_MODEL=your-vision-model
# WENTIAN_KNOWLEDGE_VISION_API_KEY=
# 音声・動画音声はlocalで既存のWentian Whisper環境を再利用します。
# WENTIAN_KNOWLEDGE_TRANSCRIPTION_MODE=local
# 外部またはローカルの互換APIを使う場合はMODEを未指定にして次を設定します。
# WENTIAN_KNOWLEDGE_TRANSCRIPTION_BASE_URL=https://your-transcription-service.example/v1
# WENTIAN_KNOWLEDGE_TRANSCRIPTION_MODEL=your-transcription-model
# WENTIAN_KNOWLEDGE_TRANSCRIPTION_API_KEY=
# 追加形式の抽出サービス。multipartのfileを受け取り、JSON {text,confirmed}を返します。
# WENTIAN_KNOWLEDGE_EXTRACTOR_URL=https://your-extractor.example/extract
# WENTIAN_KNOWLEDGE_EXTRACTOR_API_KEY=

# 資料索引はSQLiteへバッチ保存します。組織のメモリ・資料量に合わせて変更してください。
# 安全上限は100万チャンク、既定値は10万。大規模環境の性能検収は別途必要です。
# WENTIAN_KNOWLEDGE_MAX_CHUNKS=100000
# 会議の話者分離を使う場合だけ、diarized_json対応の音声APIを明示します。
# 未設定時は従来のローカルWhisperを使い、話者は未確認のまま保存します。
# WENTIAN_MEETING_DIARIZATION_BASE_URL=https://your-speech-service.example/v1
# WENTIAN_MEETING_DIARIZATION_MODEL=your-diarization-model
# WENTIAN_MEETING_DIARIZATION_API_KEY=
# 実資料の検収補助スクリプト専用。実行すると指定モデルへ資料を送信します。
# WENTIAN_KNOWLEDGE_ACCEPTANCE_BASE_URL=https://your-model-service.example/v1
# WENTIAN_KNOWLEDGE_ACCEPTANCE_MODEL=your-reviewed-model
# WENTIAN_KNOWLEDGE_ACCEPTANCE_API_KEY=
